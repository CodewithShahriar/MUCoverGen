{
  "version": 2,
  "builds": [
    {
      "src": "package.json",
      "use": "@vercel/static-build",
      "config": { "distDir": "dist/client/client" }
    }
  ],
  "routes": [
    { "src": "/assets/(.*)", "dest": "/assets/$1" },
    { "src": "/favicon.png", "dest": "/favicon.png" },
    { "src": "/robots.txt", "dest": "/robots.txt" },
    { "src": "^/(.*)$", "dest": "/index.html" }
  ]
}
